root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml,json,md,ts,tsx,js,mjs,css,html}]
indent_size = 2

[*.cs]
csharp_style_namespace_declarations = file_scoped:warning
dotnet_style_qualification_for_field = false:suggestion

# Test names are sentences with underscores (CA1707); production code keeps the rule.
[tests/**.cs]
dotnet_diagnostic.CA1707.severity = none
